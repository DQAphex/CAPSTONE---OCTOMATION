# ============================================================================
# OCTOMATION - configuracion local de Docker Compose
# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO debe subirse al repositorio.
# ============================================================================

# ------------------------------- PostgreSQL --------------------------------
# Usa una contrasena sin caracteres reservados de URL (@, :, /, #, ?).
# Si necesitas caracteres especiales, codificalos para la URL (por ejemplo @ -> %40).
POSTGRES_USER=octomation
POSTGRES_PASSWORD=cambia_esta_contrasena
# Puerto del host para DBeaver/psql. El puerto interno siempre es 5432.
POSTGRES_PORT=5433

# ------------------------------- Seguridad ---------------------------------
# Secreto usado por IAM para firmar los JWT.
JWT_SECRET=cambia_este_secreto_de_desarrollo

# ------------------------------- Puertos host ------------------------------
BILLING_PORT=4001
IAM_PORT=4002
TRANSACTIONS_PORT=4003
TENANTS_PORT=4004
PLUGINS_PORT=4005
FRONTEND_PORT=3000

# ------------------------- URL interna entre contenedores ------------------
# Tenants consume la API de IAM. Se usa el DNS interno de Docker.
IAM_INTERNAL_URL=http://iam:4002

# ------------------- Frontend: URL publicas desde el navegador -------------
# El navegador corre en el host, por eso se usa localhost y los puertos
# publicados. No cambies estas URL por nombres de servicio de Docker.
NEXT_PUBLIC_BILLING_URL=http://localhost:4001
NEXT_PUBLIC_IAM_SERVICE_URL=http://localhost:4002
NEXT_PUBLIC_TRANSACTIONS_URL=http://localhost:4003
NEXT_PUBLIC_TENANTS_URL=http://localhost:4004
NEXT_PUBLIC_PLUGINS_URL=http://localhost:4005

# --------------------------- OCTO_TRANSACTIONS -----------------------------
# URL que Transbank usa para volver despues del pago. Debe ser accesible desde
# el navegador; si pruebas desde otra maquina, cambia localhost por su IP/DNS.
TRANSACTIONS_BASE_URL=http://localhost:4003

# Ambiente Transbank: integration | production
TBK_ENV=integration
# Solo necesarias con TBK_ENV=production
TBK_COMMERCE_CODE=
TBK_CHILD_CODE=
TBK_API_KEY=

# Correo de comprobantes (opcional; si se deja vacio no se envian correos).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Panel /admin de OCTO_TRANSACTIONS (opcional; sin valores responde 503).
ADMIN_USER=
ADMIN_PASSWORD=
